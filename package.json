{
	"name": "ai-powered-3d-virtual-fitting-room",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev:api": "cd backend && .venv/bin/uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
		"test:api": "cd backend && .venv/bin/pytest -q",
		"test": "vitest run",
		"test:watch": "vitest",
		"setup:api": "bash scripts/setup-backend.sh",
		"dev:worker": "cd backend && .venv/bin/python -m app.worker",
		"db:migrate": "cd backend && .venv/bin/python -m app.db.migrate",
		"db:seed": "cd backend && .venv/bin/python -m app.db.seed",
		"lint:api": "cd backend && .venv/bin/ruff check . && .venv/bin/ruff format --check .",
		"test:all": "npm run check && npm test && npm run lint:api && npm run test:api"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/three": "^0.187.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@threlte/core": "^8.7.0",
		"@threlte/extras": "^9.23.1",
		"three": "^0.187.0"
	}
}
