# Copy to backend/.env and fill in. Never commit backend/.env.

# development | test | production
FR_ENVIRONMENT=development

# 32-byte base64 key that encrypts customer files at rest.
# Generate: .venv/bin/python -m app.core.keys
# Losing this key makes stored scans unreadable; keep a secure backup.
FR_ENCRYPTION_KEY=

# Optional overrides
# FR_DATA_DIR=../data
# FR_DATABASE_URL=sqlite:///../data/app.db
